<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.TaskDetails">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_base">

        <ImageView
            android:id="@+id/toolbar"
            android:layout_width="@dimen/size_icon_btn"
            android:layout_height="@dimen/size_icon_btn"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_btn"
            android:padding="6dp"
            android:contentDescription="@string/content_desc_back"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/taskTitle"
            style="@style/TextAppearance.Checkly.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Restock fridge — main bar" />

        <TextView
            android:id="@+id/taskDescription"
            style="@style/TextAppearance.Checkly.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            app:layout_constraintTop_toBottomOf="@id/taskTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Ensure all bottled drinks are above the fill line." />

        <LinearLayout
            android:id="@+id/pillRow"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/taskDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/taskStatus"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_status_available"
                android:textColor="@color/text_on_primary"
                android:layout_marginEnd="@dimen/space_xs"
                tools:text="Available now" />

            <TextView
                android:id="@+id/photoStatus"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_status_photo_required"
                android:textColor="@color/text_primary"
                android:text="@string/task_pill_photo_required"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/timeCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="@dimen/space_md"
            android:elevation="@dimen/elev_card"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/pillRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/labelStart"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_time_start"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/timeDivider" />

            <TextView
                android:id="@+id/startTime"
                style="@style/TextAppearance.Checkly.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/labelStart"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/timeDivider"
                tools:text="09:00" />

            <View
                android:id="@+id/timeDivider"
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:background="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/labelDue"
                style="@style/TextAppearance.Checkly.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/task_time_due"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/timeDivider"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/taskDueTime"
                style="@style/TextAppearance.Checkly.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/labelDue"
                app:layout_constraintStart_toEndOf="@id/timeDivider"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="09:30" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/labelPhoto"
            style="@style/TextAppearance.Checkly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_photo_proof_h"
            android:layout_marginTop="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/timeCard"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            tools:listitem="@layout/photo_item"
            app:layout_constraintTop_toBottomOf="@id/labelPhoto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/photoProve"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_photo_tile_empty"
            android:layout_marginTop="@dimen/space_md"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/photoList"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_plus"
                app:tint="@color/primary"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/buttonRow"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_md"
            app:layout_constraintTop_toBottomOf="@id/photoProve"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startTaskBtn"
                style="@style/Widget.Checkly.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/height_button_cta"
                android:text="@string/task_cta_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/finishTaskBtn"
                style="@style/Widget.Checkly.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/height_button_cta"
                android:text="@string/task_cta_finish"
                android:enabled="false"
                android:layout_marginStart="@dimen/space_sm" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
