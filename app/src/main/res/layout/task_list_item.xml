<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskItemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_left_accent"
    android:layout_marginVertical="@dimen/space_xs"
    android:padding="@dimen/space_md"
    android:elevation="@dimen/elev_card"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/taskTitle"
        style="@style/TextAppearance.Checkly.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Restock fridge — main bar" />

    <TextView
        android:id="@+id/photoBadge"
        style="@style/TextAppearance.Checkly.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_status_photo_required"
        android:textColor="@color/text_primary"
        android:text="@string/task_pill_photo_required"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_xs"
        app:layout_constraintTop_toBottomOf="@id/taskTitle"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/taskTime"
        style="@style/TextAppearance.Checkly.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:layout_marginTop="@dimen/space_xs"
        app:layout_constraintTop_toBottomOf="@id/taskTitle"
        app:layout_constraintStart_toEndOf="@id/photoBadge"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="09:00 → 09:30" />

    <TextView
        android:id="@+id/taskStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="UnusedIds" />

</androidx.constraintlayout.widget.ConstraintLayout>
