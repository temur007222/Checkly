<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/logInScreen">

    <fragment
        android:id="@+id/logInScreen"
        android:name="com.temurx.checkly.ui.LogInScreen"
        android:label="fragment_log_in_screen"
        tools:layout="@layout/fragment_log_in_screen" >
        <action
            android:id="@+id/action_logInScreen_to_tasksScreen"
            app:destination="@id/home" />
    </fragment>
    <fragment
        android:id="@+id/home"
        android:name="com.temurx.checkly.ui.TasksScreen"
        android:label="Home"
        tools:layout="@layout/fragment_tasks_screen" >
        <action
            android:id="@+id/action_tasksScreen_to_taskDetails"
            app:destination="@id/taskDetails" />
    </fragment>
    <fragment
        android:id="@+id/taskDetails"
        android:name="com.temurx.checkly.ui.TaskDetails"
        android:label="fragment_task_details"
        tools:layout="@layout/fragment_task_details" />
</navigation>